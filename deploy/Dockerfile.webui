# Lives in deploy/ but the build context is the repo root (see docs/HOSTINGER_DEPLOY.md) --
# every COPY path below is relative to that root, not to this file.
#
# Builds webui/'s static production bundle and serves it with plain nginx -- Traefik (k3s's
# built-in Ingress controller) already owns routing/TLS, so this image's only job is serving
# static files, nothing else. VITE_API_BASE_URL is baked in at build time (Vite env vars are
# compile-time constants -- see webui/src/api/config.ts), which makes this image specific to one
# API origin -- built locally on the deploy box and loaded straight into k3s's containerd (see the
# deploy guide), not published to Docker Hub like the API image, since a deployment-specific API
# URL baked into a publicly-tagged image wouldn't be a reusable artifact.

FROM node:22-slim AS webui-build
WORKDIR /build
COPY webui/package.json webui/package-lock.json ./
RUN npm ci
COPY webui .
ARG VITE_API_BASE_URL
RUN VITE_API_BASE_URL=${VITE_API_BASE_URL} npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=webui-build /build/dist /usr/share/nginx/html
