# See deploy/Dockerfile.dockerignore's own header comment for why this file is named/placed this
# way -- same Docker convention, one dockerignore per Dockerfile path. This build only ever needs
# webui/ and deploy/nginx.conf from the context; everything else is excluded.
.git
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
webui/node_modules
webui/dist
api
