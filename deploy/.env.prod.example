# Copy to deploy/.env.prod on the Hostinger box (never commit the real file -- it holds real
# secrets). See docs/HOSTINGER_DEPLOY.md for the full walkthrough.

# Pin to a real published tag (docker.io/sgummalla/knowledge tags) -- never "latest" here, so an
# upgrade is always a deliberate, reviewed edit to this one line, not a silent `pull`.
KNOWLEDGE_VERSION=4.3.1

# Generate real random values for these two -- do not use the values below as-is.
#   openssl rand -hex 16   (for POSTGRES_PASSWORD)
#   openssl rand -hex 32   (for SECRET_KEY)
POSTGRES_PASSWORD=
SECRET_KEY=

POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
LOG_LEVEL=INFO
