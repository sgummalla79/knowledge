# Lives in deploy/ but the build context is the repo root (see docker-compose.prod.yml's
# `context: ..`) — every COPY path below is relative to that root, not to this file.
#
# Builds webui/'s static production bundle, then serves it (and reverse-proxies api.sgummallaworks
# .com's /knowledge path — see deploy/Caddyfile) from a single Caddy image. webui/ is a standalone
# deployable from the API (see this repo's CLAUDE.md session history item 34/35) — VITE_API_BASE_URL
# is baked in at build time here (Vite env vars are compile-time constants, not runtime-configurable
# — see webui/src/api/config.ts), so this image is specific to one API origin; rebuild with a
# different build arg to point a build at a different API deployment.

FROM node:22-slim AS webui-build
WORKDIR /build
COPY webui/package.json webui/package-lock.json ./
RUN npm ci
COPY webui .
ARG VITE_API_BASE_URL
RUN VITE_API_BASE_URL=${VITE_API_BASE_URL} npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=webui-build /build/dist /srv/webui
