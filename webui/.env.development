# Loaded automatically by `npm run dev` (Vite dev mode only — not used by `npm run build`).
# Points the dev server at the fixed local-dev-preview API port from CLAUDE.md's "Local dev
# preview" conventions. Override by exporting VITE_API_BASE_URL before `npm run dev` if you're
# running the API on a different port.
VITE_API_BASE_URL=http://127.0.0.1:13102
